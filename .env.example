NODE_ENV=development
PORT=4000
API_PREFIX=v1
APP_NAME=Identra Server
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Use this value when the API runs inside docker compose.
DATABASE_URL=postgresql://identra:identra_password@db:5432/identra?schema=public

# Use this value when the API runs inside docker compose.
REDIS_URL=redis://redis:6379

# Demo-only secrets. Replace before any shared or public deployment.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# GraphQL is exposed at /graphql beside the REST /v1 API.
# Keep introspection and GraphiQL disabled in production unless explicitly needed.
GRAPHQL_INTROSPECTION=true
GRAPHQL_GRAPHIQL=true
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=300
GRAPHQL_DEFAULT_FIELD_COST=1
GRAPHQL_MAX_QUERY_NODES=1000
GRAPHQL_RATE_LIMIT_WINDOW_SECONDS=60
GRAPHQL_RATE_LIMIT_MAX_COST=1000
GRAPHQL_RATE_LIMIT_FAIL_CLOSED=false
GRAPHQL_CACHE_TTL_SECONDS=30
GRAPHQL_TRUSTED_DOCUMENTS_ENABLED=false
GRAPHQL_TRUSTED_DOCUMENT_HASHES=

POSTGRES_USER=identra
POSTGRES_PASSWORD=identra_password
POSTGRES_DB=identra
