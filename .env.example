NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=v1
APP_NAME=Identra Server
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Use this value when the API runs directly on the host machine.
DATABASE_URL=postgresql://identra:identra_password@localhost:5432/identra?schema=public

# Use this value when the API runs directly on the host machine.
REDIS_URL=redis://localhost:6379

# Demo-only secrets. Replace before any shared or public deployment.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_REGISTRATION_TOKEN_SECRET=dev_registration_secret_change_me
AUTH_REGISTRATION_TOKEN_TTL_SECONDS=900

# Password auth. Production must use strong random secrets and consider secret manager rotation.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_PEPPER=dev_password_pepper_change_me
PASSWORD_PEPPER_VERSION=v1
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCK_SECONDS=900

# Demo OTP provider. Production must replace OTP_DEMO_CODE with a real provider flow.
OTP_HMAC_SECRET=dev_otp_secret_change_me
OTP_DEMO_CODE=000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_STARTS_PER_HOUR=5

# GraphQL is exposed at /graphql beside the REST /v1 API.
# Keep introspection and GraphiQL disabled in production unless explicitly needed.
GRAPHQL_INTROSPECTION=true
GRAPHQL_GRAPHIQL=true
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=300
GRAPHQL_DEFAULT_FIELD_COST=1
GRAPHQL_MAX_QUERY_NODES=1000
GRAPHQL_RATE_LIMIT_WINDOW_SECONDS=60
GRAPHQL_RATE_LIMIT_MAX_COST=1000
GRAPHQL_RATE_LIMIT_FAIL_CLOSED=false
GRAPHQL_CACHE_TTL_SECONDS=30
GRAPHQL_TRUSTED_DOCUMENTS_ENABLED=false
GRAPHQL_TRUSTED_DOCUMENT_HASHES=

POSTGRES_USER=identra
POSTGRES_PASSWORD=identra_password
POSTGRES_DB=identra
