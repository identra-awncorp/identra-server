# Production environment for docker-compose.prod.yml. The real file lives at
# /etc/identra/server.env (outside the repo and /srv/awncorp, readable by the admin only,
# ADR-0016 §6). Every value marked REQUIRED has no default: Compose and the server refuse
# to start without it.

# --- Postgres (REQUIRED) ---
# Passwords are embedded in DATABASE_URL / REDIS_URL unescaped: use hex (openssl rand -hex 32).
POSTGRES_USER=identra
POSTGRES_PASSWORD=
POSTGRES_DB=identra

# --- Redis (REQUIRED) ---
REDIS_PASSWORD=

# --- Server secrets (REQUIRED) ---
# Each one: at least 32 characters and 16 distinct characters, all five different, no
# placeholder words (change_me, dev_, secret). Generate each with:
#   openssl rand -base64 48
# (not -hex: 64 hex characters miss one of the 16 hex digits about a quarter of the time.)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_REGISTRATION_TOKEN_SECRET=
PASSWORD_PEPPER=
OTP_HMAC_SECRET=

# --- CORS (REQUIRED, explicit https origins; empty, *, null and http are refused) ---
CORS_ORIGINS=https://identra.awncorp.vn

# --- Demo OTP ---
# Off by default in production: OTP endpoints answer 503 OTP_PROVIDER_UNAVAILABLE until a
# real SMS provider exists. Opting in for a closed demo (OTP_DEMO_ENABLED=true) also requires
# a private 6-digit OTP_DEMO_CODE (not 000000, 123456 or one repeated digit) and the E.164
# numbers allowed to use it; every other number gets 503. The code is never returned in
# responses. Do not set OTP_DEMO_CODE while the demo OTP is off (the server refuses to start).
OTP_DEMO_ENABLED=false
# OTP_DEMO_CODE=
# OTP_DEMO_PHONE_ALLOWLIST=+84900000001,+84900000002

# --- Credential features ---
# IDENTRA_PUBLIC_BASE_URL and IDENTRA_KEYS_DIR are fixed in docker-compose.prod.yml.
# Organisation back-office API keys, as org:sha256hex (never the key itself). Make one with
#   KEY=$(openssl rand -base64 32); printf %s "$KEY" | sha256sum
# hand KEY to the organisation and put e.g. truong-mau:<hex> here. Empty = no API-key access.
IDENTRA_ORG_API_KEY_HASHES=
# The school portal's sample accounts are created with (run once, again to reset):
#   docker compose ... run --rm -e DEMO_PORTAL_PASSWORD='Identra@2026' api npm run demo:provision

# --- Optional (defaults shown) ---
APP_NAME=Identra Server
API_PREFIX=v1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_REGISTRATION_TOKEN_TTL_SECONDS=900
PASSWORD_PEPPER_VERSION=v1
GRAPHQL_INTROSPECTION=false
GRAPHQL_GRAPHIQL=false
GRAPHQL_RATE_LIMIT_FAIL_CLOSED=true
