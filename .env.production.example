# Production environment for docker-compose.prod.yml. The real file lives at
# /etc/identra/server.env (outside the repo and /srv/awncorp, readable by the admin only,
# ADR-0016 §6). Every value marked REQUIRED has no default: Compose and the server refuse
# to start without it. Generate secrets with:  openssl rand -hex 32
# Use hex values for passwords: they are embedded in DATABASE_URL / REDIS_URL unescaped.

# --- Postgres (REQUIRED) ---
POSTGRES_USER=identra
POSTGRES_PASSWORD=
POSTGRES_DB=identra

# --- Redis (REQUIRED) ---
REDIS_PASSWORD=

# --- Server secrets (REQUIRED, at least 32 characters, no development defaults) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_REGISTRATION_TOKEN_SECRET=
PASSWORD_PEPPER=
OTP_HMAC_SECRET=

# --- CORS (REQUIRED, explicit origins; empty and * are refused) ---
CORS_ORIGINS=https://identra.awncorp.vn

# --- Demo OTP ---
# Off by default in production: OTP endpoints answer 503 OTP_PROVIDER_UNAVAILABLE until a
# real SMS provider exists. Set to true only as a conscious opt-in for a closed demo; the
# fixed code is then accepted but never returned in responses. Do not set OTP_DEMO_CODE
# without OTP_DEMO_ENABLED=true (the server refuses to start).
OTP_DEMO_ENABLED=false

# --- Optional (defaults shown) ---
APP_NAME=Identra Server
API_PREFIX=v1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_REGISTRATION_TOKEN_TTL_SECONDS=900
PASSWORD_PEPPER_VERSION=v1
GRAPHQL_INTROSPECTION=false
GRAPHQL_GRAPHIQL=false
GRAPHQL_RATE_LIMIT_FAIL_CLOSED=true
