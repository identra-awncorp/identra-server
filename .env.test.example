# Copy to .env.test (git-ignored). Points at the throwaway test containers from README.md
# ("Tests"); never at a shared or production database.
NODE_ENV=test
DATABASE_URL=postgresql://identra:identra_test@127.0.0.1:47432/identra_test?schema=public
REDIS_URL=redis://127.0.0.1:47379
# The credential test files start the app with IDENTRA_KEYS_DIR set to this demo PKI (made by
# identra-sdk/scripts/pki/make-demo-pki.sh, outside git); they fail, not skip, when it is
# missing. The other test files run without keys. Never commit keys.
# Default: $HOME/.identra/demo-pki
# IDENTRA_TEST_KEYS_DIR=/absolute/path/to/demo-pki
# The port the end-to-end tests listen on (127.0.0.1). Pick a free one on a shared machine.
# Default: 47400
# IDENTRA_TEST_PORT=47407
