# Used by BuildKit for Dockerfile (same directory, same base name). Paths are relative to the
# build context, which is the parent directory. Allow-list of files: the parent also holds
# unrelated projects and secrets that must never enter an image or the build context.
# prisma/seed.ts (demo data and a demo password) stays out, so it is not in any image.
*
!identra-server/package.json
!identra-server/package-lock.json
!identra-server/nest-cli.json
!identra-server/tsconfig.json
!identra-server/tsconfig.build.json
!identra-server/prisma/schema.prisma
!identra-server/prisma/migrations/**
!identra-server/src/**
# The SDK: manifests and the built output of the two packages the server uses. No sources,
# no tests, no .pki/ test keys, no node_modules (installed inside the image).
!identra-sdk/package.json
!identra-sdk/package-lock.json
!identra-sdk/packages/*/package.json
!identra-sdk/packages/core/dist/**
!identra-sdk/packages/server/dist/**
