{
  "name": "identra-server",
  "version": "0.1.0",
  "private": true,
  "description": "Identra backend server for mobile app, website demos, and future super-app modules.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test": "tsc -p tsconfig.test.json && node dist-test/test/global-setup.js && node --env-file=.env.test --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "demo:provision": "node dist/src/scripts/demo-provision.js",
    "demo:provision-product": "node dist/src/scripts/demo-provision-product.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@identra/sdk-core": "file:../identra-sdk/packages/core",
    "@identra/sdk-server": "file:../identra-sdk/packages/server",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.3",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^1.1.1",
    "ioredis": "^5.4.1",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@identra/sdk-app": "file:../identra-sdk/packages/app",
    "@identra/sdk-client": "file:../identra-sdk/packages/client",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "js-yaml": "5.5.0",
    "multer": "2.5.0",
    "ws": "8.21.0"
  }
}
